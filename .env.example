# Set to "gemini", "groq", or leave blank for rules-only mode.
AI_PROVIDER=

# Set only the key matching AI_PROVIDER. Keep these values server-side.
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional comma-separated exact frontend origins for API CORS.
# Example: https://caytec.github.io,https://your-domain.example
ALLOWED_ORIGINS=
